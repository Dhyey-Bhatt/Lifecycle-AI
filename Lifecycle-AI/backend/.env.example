# Server Configuration
PORT=5000

# AI Provider Configuration (Model-Agnostic Gateway)
# Available Providers: 'openai' | 'local'
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini

# OpenAI API Key (Kept strictly on the backend, never exposed to frontend)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Local / Custom Lifecycle AI Model endpoint
# LOCAL_AI_ENDPOINT=http://localhost:11434
# LOCAL_AI_MODEL=lifecycle-ai-v1

# Supabase Credentials (Optional - Falls back to local in-memory store if unset)
# Get these from your Supabase Project Settings -> API
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
# The service role key is optional but useful for admin overrides if RLS is strict
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

